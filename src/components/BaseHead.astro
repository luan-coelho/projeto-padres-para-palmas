---
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION } from '../consts'
import logoColorida from '../assets/images/logo-colorida.png'

interface Props {
  title: string
  description: string
  canonicalURL?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  jsonLd?: object[]
}
const {
  title,
  description,
  canonicalURL = SITE_URL,
  ogImage = logoColorida.src,
  ogImageAlt = `${SITE_TITLE} - identidade visual`,
  ogType = 'website',
  jsonLd = []
} = Astro.props

const absoluteOgImage = new URL(ogImage, SITE_URL).toString()
const organizationLogo = new URL(logoColorida.src, SITE_URL).toString()

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_TITLE,
  url: SITE_URL,
  logo: organizationLogo,
  sameAs: ['https://www.instagram.com/padresparapalmas']
}

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: SITE_URL,
  inLanguage: 'pt-BR',
  description: SITE_DESCRIPTION,
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE
  }
}

const allJsonLd = [organizationJsonLd, websiteJsonLd, ...jsonLd]
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta
  name="googlebot"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>
<meta name="theme-color" content="#9c5a41" />
<meta name="author" content="Arquidiocese de Palmas" />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Links -->
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />

<!-- JSON-LD -->
{allJsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
