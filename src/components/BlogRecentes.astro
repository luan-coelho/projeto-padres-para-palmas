---
import { db } from '@/db'
import { posts as postsTable } from '@/db/schema'
import { desc, eq } from 'drizzle-orm'

interface Props {
  sectionLabel?: string
  title?: string
  titleHighlight?: string
  maxPosts?: number
}

const {
  sectionLabel = 'Blog',
  title = 'Reflexões e',
  titleHighlight = 'Partilhas',
  maxPosts = 3,
} = Astro.props

const posts = await db
  .select()
  .from(postsTable)
  .where(eq(postsTable.published, true))
  .orderBy(desc(postsTable.createdAt))
  .limit(maxPosts)
---

<section id="blog" data-slot="blog" class="bg-bg-verde py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <span class="text-verde mb-4 inline-block text-sm font-semibold tracking-wider uppercase">
        {sectionLabel}
      </span>
      <h2 class="text-grafite text-3xl font-light sm:text-4xl lg:text-5xl">
        {title} <span class="font-semibold">{titleHighlight}</span>
      </h2>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-grafite/60 text-center text-lg">
          Nenhuma publicação por enquanto. Volte em breve!
        </p>
      ) : (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <a
              href={`/blog/${post.slug}`}
              class="group block rounded-2xl bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
            >
              <article>
                <time
                  datetime={new Date(post.createdAt).toISOString()}
                  class="text-grafite/50 text-sm"
                >
                  {new Date(post.createdAt).toLocaleDateString('pt-BR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h3 class="text-grafite group-hover:text-verde mt-2 text-xl font-semibold transition-colors">
                  {post.title}
                </h3>
                <p class="text-grafite/70 mt-2 line-clamp-3">
                  {post.description}
                </p>
              </article>
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length > 0 && (
        <div class="mt-12 text-center">
          <a
            href="/blog"
            class="bg-verde hover:bg-verde/90 inline-flex items-center gap-2 rounded-full px-8 py-3 font-medium text-white transition-colors"
          >
            Ver todas as publicações
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>
