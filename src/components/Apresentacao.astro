---
interface Props {
  title?: string
  titleHighlight?: string
  description?: string
}

const {
  title = 'Nascemos para fortalecer a',
  titleHighlight = 'cultura vocacional',
  description = 'O Projeto Padres para a Igreja de Palmas, da Arquidiocese de Palmas-TO, foi lançado dia <strong>20 de fevereiro de 2026</strong>, na paróquia São José, inserido no contexto dos 30 anos da Arquidiocese de Palmas. Embora nosso projeto tenha tido o marco de uma data inicial ele não tem data para ser finalizado. É um projeto contínuo.'
} = Astro.props
---

<section id="apresentacao" data-slot="apresentacao" class="bg-white py-20 lg:py-28">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-grafite mb-8 text-3xl leading-tight font-light sm:text-4xl lg:text-5xl">
      {title}
      <br />
      <span class="text-azul font-semibold">{titleHighlight}</span>
    </h2>
    <p
      class="text-grafite/80 mx-auto max-w-3xl text-lg leading-relaxed sm:text-xl"
      set:html={description}
    />
  </div>
</section>
