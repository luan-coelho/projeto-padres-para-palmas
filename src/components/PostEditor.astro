<script>
  import { upload } from '@vercel/blob/client'
  import { Editor } from '@tiptap/core'
  import StarterKit from '@tiptap/starter-kit'
  import Link from '@tiptap/extension-link'
  import Image from '@tiptap/extension-image'
  import Underline from '@tiptap/extension-underline'

  // Custom Image extension with width support
  const ResizableImage = Image.extend({
    addAttributes() {
      return {
        ...this.parent?.(),
        width: {
          default: null,
          parseHTML: el => el.getAttribute('width') || el.style.width?.replace('px', '') || null,
          renderHTML: attrs => {
            if (!attrs.width) return {}
            return { width: attrs.width, style: `width: ${attrs.width}px` }
          },
        },
      }
    },
  })
  import Placeholder from '@tiptap/extension-placeholder'
  import TextAlign from '@tiptap/extension-text-align'
  import Highlight from '@tiptap/extension-highlight'
  import { Color } from '@tiptap/extension-color'
  import { TextStyle } from '@tiptap/extension-text-style'
  import Superscript from '@tiptap/extension-superscript'
  import Subscript from '@tiptap/extension-subscript'
  import Youtube from '@tiptap/extension-youtube'
  import CharacterCount from '@tiptap/extension-character-count'
  import Typography from '@tiptap/extension-typography'

  const form = document.getElementById('post-form') as HTMLFormElement
  const postSubmitButton = document.getElementById('post-submit') as HTMLButtonElement
  const formStatus = document.getElementById('form-status')!
  const autosaveStatus = document.getElementById('autosave-status')!
  const titleInput = document.getElementById('title') as HTMLInputElement
  const slugPreview = document.getElementById('slug-value')
  const wordCountEl = document.getElementById('word-count')!
  const charCountEl = document.getElementById('char-count')!
  const postId = form.dataset.postId
  const mode = form.dataset.mode as 'create' | 'edit'
  const draftKey = mode === 'edit' ? `draft-${postId}` : 'draft-novo'
  const initialContent = (window as any).__editorInitialContent || ''

  const MAX_IMAGE_SIZE_IN_BYTES = 5 * 1024 * 1024
  const IMAGE_EXTENSION_BY_TYPE: Record<string, string> = {
    'image/jpeg': 'jpg',
    'image/png': 'png',
    'image/webp': 'webp',
    'image/avif': 'avif',
  }

  type ImageDestination = 'content' | 'covers'
  type StatusTone = 'default' | 'error' | 'success'

  function setUploadStatus(element: HTMLElement, message: string, tone: StatusTone = 'default') {
    element.textContent = message
    element.classList.toggle('is-error', tone === 'error')
    element.classList.toggle('is-success', tone === 'success')
  }

  function validateImageFile(file: File) {
    if (!IMAGE_EXTENSION_BY_TYPE[file.type]) {
      throw new Error('Formato não permitido. Use JPG, PNG, WebP ou AVIF.')
    }

    if (file.size === 0) {
      throw new Error('O arquivo selecionado está vazio.')
    }

    if (file.size > MAX_IMAGE_SIZE_IN_BYTES) {
      throw new Error('A imagem deve ter no máximo 5 MB.')
    }
  }

  function buildImagePathname(file: File, destination: ImageDestination) {
    const baseName =
      file.name
        .replace(/\.[^.]+$/, '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '')
        .slice(0, 120) || 'imagem'

    return `blog/${destination}/${baseName}.${IMAGE_EXTENSION_BY_TYPE[file.type]}`
  }

  async function uploadBlogImage(
    file: File,
    destination: ImageDestination,
    onProgress: (percentage: number) => void,
  ) {
    validateImageFile(file)

    return upload(buildImagePathname(file, destination), file, {
      access: 'public',
      handleUploadUrl: '/api/uploads/images',
      contentType: file.type,
      onUploadProgress: progress => onProgress(progress.percentage),
    })
  }

  function getUploadErrorMessage(error: unknown) {
    if (error instanceof Error && error.message) return error.message
    return 'Não foi possível enviar a imagem. Tente novamente.'
  }

  // ---- Editor ----
  const editor = new Editor({
    element: document.getElementById('editor-content')!,
    extensions: [
      StarterKit.configure({ heading: { levels: [2, 3] } }),
      Link.configure({ openOnClick: false, HTMLAttributes: { target: '_blank', rel: 'noopener noreferrer' } }),
      ResizableImage,
      Underline,
      Placeholder.configure({ placeholder: 'Comece a escrever seu artigo aqui...' }),
      TextAlign.configure({ types: ['heading', 'paragraph'] }),
      Highlight.configure({ multicolor: true }),
      TextStyle,
      Color,
      Superscript,
      Subscript,
      Youtube.configure({ inline: false, ccLanguage: 'pt' }),
      CharacterCount,
      Typography,
    ],
    content: initialContent || '<p></p>',
    onUpdate: () => { updateToolbar(); updateCounts() },
    onSelectionUpdate: () => updateToolbar(),
  })

  // ---- Toolbar state ----
  const headingSelect = document.getElementById('heading-select') as HTMLSelectElement

  function updateToolbar() {
    document.querySelectorAll('#editor-toolbar .toolbar-btn[data-action]').forEach(btn => {
      const a = (btn as HTMLElement).dataset.action!
      let active = false
      switch (a) {
        case 'bold': active = editor.isActive('bold'); break
        case 'italic': active = editor.isActive('italic'); break
        case 'underline': active = editor.isActive('underline'); break
        case 'strike': active = editor.isActive('strike'); break
        case 'superscript': active = editor.isActive('superscript'); break
        case 'subscript': active = editor.isActive('subscript'); break
        case 'bulletList': active = editor.isActive('bulletList'); break
        case 'orderedList': active = editor.isActive('orderedList'); break
        case 'blockquote': active = editor.isActive('blockquote'); break
        case 'codeBlock': active = editor.isActive('codeBlock'); break
        case 'link': active = editor.isActive('link'); break
        case 'alignLeft': active = editor.isActive({ textAlign: 'left' }); break
        case 'alignCenter': active = editor.isActive({ textAlign: 'center' }); break
        case 'alignRight': active = editor.isActive({ textAlign: 'right' }); break
        case 'alignJustify': active = editor.isActive({ textAlign: 'justify' }); break
      }
      btn.classList.toggle('is-active', active)
    })

    if (editor.isActive('heading', { level: 2 })) headingSelect.value = '2'
    else if (editor.isActive('heading', { level: 3 })) headingSelect.value = '3'
    else headingSelect.value = 'paragraph'
  }

  function updateCounts() {
    wordCountEl.textContent = `${editor.storage.characterCount.words()} palavras`
    charCountEl.textContent = `${editor.storage.characterCount.characters()} caracteres`
  }
  updateCounts()

  // ---- Toolbar actions ----
  document.getElementById('editor-toolbar')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.toolbar-btn[data-action]') as HTMLElement | null
    if (!btn) return
    const a = btn.dataset.action
    switch (a) {
      case 'bold': editor.chain().focus().toggleBold().run(); break
      case 'italic': editor.chain().focus().toggleItalic().run(); break
      case 'underline': editor.chain().focus().toggleUnderline().run(); break
      case 'strike': editor.chain().focus().toggleStrike().run(); break
      case 'superscript': editor.chain().focus().toggleSuperscript().run(); break
      case 'subscript': editor.chain().focus().toggleSubscript().run(); break
      case 'bulletList': editor.chain().focus().toggleBulletList().run(); break
      case 'orderedList': editor.chain().focus().toggleOrderedList().run(); break
      case 'blockquote': editor.chain().focus().toggleBlockquote().run(); break
      case 'codeBlock': editor.chain().focus().toggleCodeBlock().run(); break
      case 'horizontalRule': editor.chain().focus().setHorizontalRule().run(); break
      case 'alignLeft': editor.chain().focus().setTextAlign('left').run(); break
      case 'alignCenter': editor.chain().focus().setTextAlign('center').run(); break
      case 'alignRight': editor.chain().focus().setTextAlign('right').run(); break
      case 'alignJustify': editor.chain().focus().setTextAlign('justify').run(); break
      case 'undo': editor.chain().focus().undo().run(); break
      case 'redo': editor.chain().focus().redo().run(); break
      case 'link': {
        if (editor.isActive('link')) { editor.chain().focus().unsetLink().run() }
        else { openDialog('link') }
        break
      }
      case 'image': { openDialog('image'); break }
      case 'youtube': { openDialog('youtube'); break }
    }
  })

  headingSelect.addEventListener('change', () => {
    const v = headingSelect.value
    if (v === 'paragraph') editor.chain().focus().setParagraph().run()
    else editor.chain().focus().toggleHeading({ level: Number(v) as 2 | 3 }).run()
  })

  // ---- Color popovers ----
  function setupColorPopover(btnId: string, popoverId: string, applyFn: (color: string) => void) {
    const btn = document.getElementById(btnId)!
    const popover = document.getElementById(popoverId)!

    btn.addEventListener('click', e => {
      e.stopPropagation()
      document.querySelectorAll('.color-popover').forEach(p => { if (p !== popover) p.classList.add('hidden') })
      popover.classList.toggle('hidden')
    })

    popover.addEventListener('click', e => {
      const swatch = (e.target as HTMLElement).closest('.color-swatch') as HTMLElement | null
      if (!swatch) return
      const color = swatch.dataset.color ?? swatch.dataset.highlight ?? ''
      applyFn(color)
      popover.classList.add('hidden')
    })
  }

  setupColorPopover('text-color-btn', 'text-color-popover', color => {
    if (color) {
      editor.chain().focus().setColor(color).run()
      document.getElementById('text-color-indicator')!.style.background = color
    } else {
      editor.chain().focus().unsetColor().run()
      document.getElementById('text-color-indicator')!.style.background = '#1a1a1a'
    }
  })

  setupColorPopover('highlight-btn', 'highlight-popover', color => {
    if (color) editor.chain().focus().toggleHighlight({ color }).run()
    else editor.chain().focus().unsetHighlight().run()
  })

  document.addEventListener('click', () => {
    document.querySelectorAll('.color-popover').forEach(p => p.classList.add('hidden'))
  })

  // ---- Dialogs ----
  const dialogs = {
    link: document.getElementById('dialog-link') as HTMLDialogElement,
    image: document.getElementById('dialog-image') as HTMLDialogElement,
    youtube: document.getElementById('dialog-youtube') as HTMLDialogElement,
  }
  const imageDialogForm = document.getElementById('image-dialog-form') as HTMLFormElement
  const imageFileInput = document.getElementById('dialog-image-file') as HTMLInputElement
  const imageUrlInput = document.getElementById('dialog-image-url') as HTMLInputElement
  const imageAltInput = document.getElementById('dialog-image-alt') as HTMLInputElement
  const imageDialogStatus = document.getElementById('dialog-image-status')!
  const imageDialogProgress = document.getElementById('dialog-image-progress') as HTMLProgressElement
  const imageDialogSubmit = document.getElementById('dialog-image-submit') as HTMLButtonElement
  let imageDialogIsUploading = false

  function setImageDialogUploading(isUploading: boolean) {
    imageDialogIsUploading = isUploading
    dialogs.image.querySelectorAll('button, input').forEach(control => {
      ;(control as HTMLButtonElement | HTMLInputElement).disabled = isUploading
    })
    imageDialogProgress.hidden = !isUploading
    imageDialogSubmit.textContent = isUploading ? 'Enviando... 0%' : 'Inserir imagem'
  }

  function openDialog(type: 'link' | 'image' | 'youtube') {
    const dialog = dialogs[type]
    // Reset inputs
    dialog.querySelectorAll('input').forEach(i => (i as HTMLInputElement).value = '')
    if (type === 'image') {
      setImageDialogUploading(false)
      imageDialogProgress.value = 0
      setUploadStatus(imageDialogStatus, '')
    }
    dialog.showModal()
  }

  // Close and cancel buttons
  document.querySelectorAll('.dialog-cancel, .dialog-close').forEach(btn => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement).close()
      editor.chain().focus().run()
    })
  })

  // Link dialog submit
  dialogs.link.querySelector('form')!.addEventListener('submit', () => {
    const url = (document.getElementById('dialog-link-url') as HTMLInputElement).value
    if (url) editor.chain().focus().extendMarkRange('link').setLink({ href: url }).run()
  })

  imageFileInput.addEventListener('change', () => {
    const file = imageFileInput.files?.[0]
    if (!file) {
      setUploadStatus(imageDialogStatus, '')
      return
    }

    try {
      validateImageFile(file)
      setUploadStatus(
        imageDialogStatus,
        `${file.name} selecionada (${(file.size / 1024 / 1024).toFixed(1)} MB).`,
      )
    } catch (error) {
      imageFileInput.value = ''
      setUploadStatus(imageDialogStatus, getUploadErrorMessage(error), 'error')
    }
  })

  // Image dialog submit
  imageDialogForm.addEventListener('submit', async event => {
    event.preventDefault()

    const file = imageFileInput.files?.[0]
    const manualUrl = imageUrlInput.value.trim()
    const alt = imageAltInput.value.trim()

    if (!file && !manualUrl) {
      setUploadStatus(imageDialogStatus, 'Selecione uma imagem ou informe uma URL.', 'error')
      return
    }

    if (!file) {
      editor.chain().focus().setImage({ src: manualUrl, alt: alt || undefined }).run()
      dialogs.image.close()
      return
    }

    setImageDialogUploading(true)
    setUploadStatus(imageDialogStatus, 'Preparando envio...')

    try {
      const blob = await uploadBlogImage(file, 'content', percentage => {
        const roundedPercentage = Math.round(percentage)
        imageDialogProgress.value = roundedPercentage
        imageDialogProgress.textContent = `${roundedPercentage}%`
        imageDialogSubmit.textContent = `Enviando... ${roundedPercentage}%`
        setUploadStatus(imageDialogStatus, `Enviando imagem: ${roundedPercentage}%`)
      })

      editor.chain().focus().setImage({ src: blob.url, alt: alt || undefined }).run()
      dialogs.image.close()
    } catch (error) {
      setUploadStatus(imageDialogStatus, getUploadErrorMessage(error), 'error')
    } finally {
      setImageDialogUploading(false)
    }
  })

  // YouTube dialog submit
  dialogs.youtube.querySelector('form')!.addEventListener('submit', () => {
    const url = (document.getElementById('dialog-youtube-url') as HTMLInputElement).value
    if (url) editor.chain().focus().setYoutubeVideo({ src: url }).run()
  })

  // Close dialogs on backdrop click (outside the dialog box)
  Object.values(dialogs).forEach(dialog => {
    dialog.addEventListener('click', e => {
      const rect = dialog.getBoundingClientRect()
      const clickedOutside =
        e.clientX < rect.left || e.clientX > rect.right ||
        e.clientY < rect.top || e.clientY > rect.bottom
      if (clickedOutside && !(dialog === dialogs.image && imageDialogIsUploading)) {
        dialog.close()
        editor.chain().focus().run()
      }
    })
  })
  dialogs.image.addEventListener('cancel', event => {
    if (imageDialogIsUploading) event.preventDefault()
  })

  // ---- Cover image upload ----
  const heroImageInput = document.getElementById('heroImage') as HTMLInputElement
  const heroImageFileInput = document.getElementById('hero-image-file') as HTMLInputElement
  const heroUploadStatus = document.getElementById('hero-upload-status')!
  const heroImagePreview = document.getElementById('hero-image-preview')!
  const heroImagePreviewImg = document.getElementById('hero-image-preview-img') as HTMLImageElement

  function updateHeroImagePreview(url: string) {
    if (!url) {
      heroImagePreview.classList.add('hidden')
      heroImagePreviewImg.removeAttribute('src')
      return
    }

    heroImagePreviewImg.src = url
    heroImagePreview.classList.remove('hidden')
  }

  heroImageInput.addEventListener('change', () => {
    updateHeroImagePreview(heroImageInput.value.trim())
  })

  heroImageFileInput.addEventListener('change', async () => {
    const file = heroImageFileInput.files?.[0]
    if (!file) return

    heroImageFileInput.disabled = true
    postSubmitButton.disabled = true
    setUploadStatus(heroUploadStatus, 'Preparando envio...')

    try {
      const blob = await uploadBlogImage(file, 'covers', percentage => {
        setUploadStatus(heroUploadStatus, `Enviando imagem: ${Math.round(percentage)}%`)
      })

      heroImageInput.value = blob.url
      updateHeroImagePreview(blob.url)
      setUploadStatus(heroUploadStatus, 'Imagem enviada e pronta para salvar.', 'success')
      saveDraft()
    } catch (error) {
      setUploadStatus(heroUploadStatus, getUploadErrorMessage(error), 'error')
    } finally {
      heroImageFileInput.value = ''
      heroImageFileInput.disabled = false
      postSubmitButton.disabled = false
    }
  })

  // ---- Slug ----
  function generateSlug(title: string): string {
    return title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
  }
  if (slugPreview) {
    titleInput.addEventListener('input', () => { slugPreview.textContent = generateSlug(titleInput.value) || '...' })
  }

  // ---- Autosave ----
  function saveDraft() {
    const html = editor.getHTML()
    const data = {
      title: titleInput.value,
      description: (document.getElementById('description') as HTMLInputElement).value,
      content: html, heroImage: (document.getElementById('heroImage') as HTMLInputElement).value,
      authorName: (document.getElementById('authorName') as HTMLInputElement).value,
      published: (document.getElementById('published') as HTMLInputElement).checked,
      slug: (document.getElementById('slug') as HTMLInputElement)?.value || '',
      savedAt: Date.now(),
    }
    if (!data.title && html === '<p></p>') return
    localStorage.setItem(draftKey, JSON.stringify(data))
    const time = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
    autosaveStatus.textContent = `Rascunho salvo as ${time}`
  }

  function restoreDraft() {
    const saved = localStorage.getItem(draftKey)
    if (!saved) return
    const data = JSON.parse(saved)
    if (mode === 'edit' && initialContent) return
    const time = new Date(data.savedAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
    if (!confirm(`Existe um rascunho salvo as ${time}. Deseja restaurar?`)) { localStorage.removeItem(draftKey); return }
    titleInput.value = data.title || ''
    ;(document.getElementById('description') as HTMLInputElement).value = data.description || ''
    ;(document.getElementById('heroImage') as HTMLInputElement).value = data.heroImage || ''
    updateHeroImagePreview(data.heroImage || '')
    ;(document.getElementById('authorName') as HTMLInputElement).value = data.authorName || ''
    ;(document.getElementById('published') as HTMLInputElement).checked = data.published || false
    if (data.content) editor.commands.setContent(data.content)
    const slugInput = document.getElementById('slug') as HTMLInputElement | null
    if (slugInput && data.slug) slugInput.value = data.slug
    if (slugPreview) slugPreview.textContent = generateSlug(data.title) || '...'
    updateCounts()
  }

  const autosaveInterval = setInterval(saveDraft, 30000)
  restoreDraft()

  // ---- Submit ----
  form.addEventListener('submit', async e => {
    e.preventDefault()
    const authorName = (document.getElementById('authorName') as HTMLInputElement).value
    const data: Record<string, unknown> = {
      title: titleInput.value,
      description: (document.getElementById('description') as HTMLInputElement).value,
      content: editor.getHTML(),
      heroImage: (document.getElementById('heroImage') as HTMLInputElement).value || null,
      published: (document.getElementById('published') as HTMLInputElement).checked,
      authorName: authorName || undefined,
    }
    if (mode === 'edit') data.slug = (document.getElementById('slug') as HTMLInputElement).value

    formStatus.textContent = 'Salvando...'
    formStatus.className = 'text-sm text-grafite/60'
    try {
      const url = mode === 'edit' ? `/api/posts/${postId}` : '/api/posts'
      const res = await fetch(url, { method: mode === 'edit' ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
      if (res.ok) {
        clearInterval(autosaveInterval); localStorage.removeItem(draftKey)
        if (mode === 'create') window.location.href = '/admin'
        else { formStatus.textContent = 'Salvo com sucesso!'; formStatus.className = 'text-sm text-green-600'; autosaveStatus.textContent = '' }
      } else { const error = await res.text(); formStatus.textContent = `Erro: ${error}`; formStatus.className = 'text-sm text-red-600' }
    } catch { formStatus.textContent = 'Erro de conexao.'; formStatus.className = 'text-sm text-red-600' }
  })

  // ---- Image toolbar ----
  const imageToolbar = document.getElementById('image-toolbar')!
  const editorWrapper = document.getElementById('editor-wrapper')!

  function updateImageToolbar() {
    if (!editor.isActive('image')) {
      imageToolbar.classList.add('hidden')
      return
    }

    const { node } = editor.state.selection as any
    if (!node || node.type.name !== 'image') {
      imageToolbar.classList.add('hidden')
      return
    }

    // Find the selected image element in the DOM
    const pos = editor.state.selection.from
    let imgEl: HTMLElement | null = null

    try {
      const nodeDOM = editor.view.nodeDOM(pos)
      if (nodeDOM instanceof HTMLElement) {
        imgEl = nodeDOM.nodeName === 'IMG' ? nodeDOM : nodeDOM.querySelector('img')
      }
    } catch { /* ignore */ }

    if (!imgEl) {
      // Fallback: find the selected node via ProseMirror class
      imgEl = editorWrapper.querySelector('.ProseMirror-selectednode') as HTMLElement
      if (imgEl && imgEl.nodeName !== 'IMG') imgEl = imgEl.querySelector('img')
    }

    if (!imgEl) {
      imageToolbar.classList.add('hidden')
      return
    }

    const imgRect = imgEl.getBoundingClientRect()

    // Show first to get correct offsetHeight
    imageToolbar.classList.remove('hidden')

    // Position centered above the image (fixed to viewport)
    const toolbarH = imageToolbar.offsetHeight
    imageToolbar.style.top = `${imgRect.top - toolbarH - 8}px`
    imageToolbar.style.left = `${imgRect.left + imgRect.width / 2}px`

    // Highlight active size
    const currentWidth = node.attrs.width
    imageToolbar.querySelectorAll('.image-toolbar-btn').forEach(btn => {
      const w = (btn as HTMLElement).dataset.imgWidth
      btn.classList.toggle('is-active', w === String(currentWidth || ''))
    })
  }

  editor.on('selectionUpdate', updateImageToolbar)
  editor.on('update', () => { if (editor.isActive('image')) updateImageToolbar(); else imageToolbar.classList.add('hidden') })

  imageToolbar.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('.image-toolbar-btn') as HTMLElement | null
    if (!btn) return
    const width = btn.dataset.imgWidth
    if (width) {
      editor.chain().focus().updateAttributes('image', { width: Number(width) }).run()
    } else {
      editor.chain().focus().updateAttributes('image', { width: null }).run()
    }
    updateImageToolbar()
  })

  // Hide image toolbar when clicking outside
  document.addEventListener('click', e => {
    if (!editorWrapper.contains(e.target as Node) && !imageToolbar.contains(e.target as Node)) {
      imageToolbar.classList.add('hidden')
    }
  })

  // ---- Preview panel ----
  const previewPanel = document.getElementById('preview-panel')!
  const previewToggle = document.getElementById('preview-toggle')!
  const previewClose = document.getElementById('preview-close')!
  const previewTitle = document.getElementById('preview-title')!
  const previewDate = document.getElementById('preview-date')!
  const previewAuthor = document.getElementById('preview-author')!
  const previewContent = document.getElementById('preview-content')!

  function openPreview() {
    previewTitle.textContent = titleInput.value || 'Sem titulo'
    previewDate.textContent = new Date().toLocaleDateString('pt-BR', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
    const author = (document.getElementById('authorName') as HTMLInputElement).value || 'Projeto Padres para a Igreja de Palmas'
    previewAuthor.textContent = `por ${author}`
    previewContent.innerHTML = editor.getHTML()
    previewPanel.classList.remove('hidden')
    document.body.style.overflow = 'hidden'
  }

  function closePreview() {
    previewPanel.classList.add('hidden')
    document.body.style.overflow = ''
  }

  previewToggle.addEventListener('click', openPreview)
  previewClose.addEventListener('click', closePreview)
  previewPanel.addEventListener('keydown', e => { if (e.key === 'Escape') closePreview() })
</script>
