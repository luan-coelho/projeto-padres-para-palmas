---
interface Props {
  post?: {
    id: number
    title: string
    slug: string
    description: string
    content: string
    authorName: string
    heroImage: string | null
    published: boolean
  }
}

const { post } = Astro.props
const isEditing = !!post
---

<form
  id="post-form"
  data-post-id={post?.id}
  data-mode={isEditing ? 'edit' : 'create'}
  class="space-y-6"
>
  <!-- Titulo -->
  <div>
    <label for="title" class="mb-1 block text-sm font-medium">Titulo</label>
    <input
      type="text"
      id="title"
      name="title"
      required
      value={post?.title || ''}
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-azul focus:ring-azul focus:outline-none focus:ring-1"
      placeholder="Titulo da publicacao"
    />
  </div>

  {
    isEditing ? (
      <div>
        <label for="slug" class="mb-1 block text-sm font-medium">
          Slug <span class="text-grafite/50 font-normal">(URL do post)</span>
        </label>
        <input type="text" id="slug" name="slug" required value={post.slug}
          class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-azul focus:ring-azul focus:outline-none focus:ring-1" />
      </div>
    ) : (
      <p id="slug-preview" class="text-grafite/50 -mt-2 text-sm">
        URL: /blog/<span id="slug-value">...</span>
      </p>
    )
  }

  <div>
    <label for="description" class="mb-1 block text-sm font-medium">Descricao</label>
    <input
      type="text"
      id="description"
      name="description"
      required
      value={post?.description || ''}
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-azul focus:ring-azul focus:outline-none focus:ring-1"
      placeholder="Breve descricao para listagem e SEO"
    />
  </div>

  <!-- Editor WYSIWYG -->
  <div>
    <label class="mb-1 block text-sm font-medium">Conteudo</label>
    <div id="editor-wrapper" class="editor-wrapper">
      <div id="editor-toolbar" class="editor-toolbar">
        <!-- Tipo de texto -->
        <div class="toolbar-group">
          <select id="heading-select" title="Tipo de texto" class="toolbar-select">
            <option value="paragraph">Paragrafo</option>
            <option value="2">Titulo</option>
            <option value="3">Subtitulo</option>
          </select>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Formatacao inline -->
        <div class="toolbar-group">
          <button type="button" data-action="bold" title="Negrito (Ctrl+B)" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
          </button>
          <button type="button" data-action="italic" title="Italico (Ctrl+I)" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
          </button>
          <button type="button" data-action="underline" title="Sublinhado (Ctrl+U)" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><line x1="4" x2="20" y1="20" y2="20"/></svg>
          </button>
          <button type="button" data-action="strike" title="Tachado" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4H9a3 3 0 0 0-2.83 4"/><path d="M14 12a4 4 0 0 1 0 8H6"/><line x1="4" x2="20" y1="12" y2="12"/></svg>
          </button>
          <button type="button" data-action="superscript" title="Sobrescrito" class="toolbar-btn text-xs">
            X<sup>2</sup>
          </button>
          <button type="button" data-action="subscript" title="Subscrito" class="toolbar-btn text-xs">
            X<sub>2</sub>
          </button>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Cores -->
        <div class="toolbar-group">
          <div class="color-dropdown-wrapper">
            <button type="button" id="text-color-btn" title="Cor do texto" class="toolbar-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="m6 16 6-12 6 12"/><path d="M8 12h8"/></svg>
              <span id="text-color-indicator" class="color-indicator" style="background:#1a1a1a"></span>
            </button>
            <div id="text-color-popover" class="color-popover hidden">
              <button type="button" data-color="#1a1a1a" class="color-swatch" style="background:#1a1a1a" title="Padrao"></button>
              <button type="button" data-color="#00aeef" class="color-swatch" style="background:#00aeef" title="Azul"></button>
              <button type="button" data-color="#62a884" class="color-swatch" style="background:#62a884" title="Verde"></button>
              <button type="button" data-color="#9a7b4f" class="color-swatch" style="background:#9a7b4f" title="Marrom"></button>
              <button type="button" data-color="#dc2626" class="color-swatch" style="background:#dc2626" title="Vermelho"></button>
              <button type="button" data-color="#6b7280" class="color-swatch" style="background:#6b7280" title="Cinza"></button>
              <button type="button" data-color="" class="color-swatch color-swatch-remove" title="Remover cor">&#x2715;</button>
            </div>
          </div>
          <div class="color-dropdown-wrapper">
            <button type="button" id="highlight-btn" title="Marca-texto" class="toolbar-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/></svg>
            </button>
            <div id="highlight-popover" class="color-popover hidden">
              <button type="button" data-highlight="#fef9c3" class="color-swatch" style="background:#fef9c3" title="Amarelo"></button>
              <button type="button" data-highlight="#dcfce7" class="color-swatch" style="background:#dcfce7" title="Verde"></button>
              <button type="button" data-highlight="#dbeafe" class="color-swatch" style="background:#dbeafe" title="Azul"></button>
              <button type="button" data-highlight="#fce7f3" class="color-swatch" style="background:#fce7f3" title="Rosa"></button>
              <button type="button" data-highlight="" class="color-swatch color-swatch-remove" title="Remover">&#x2715;</button>
            </div>
          </div>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Alinhamento -->
        <div class="toolbar-group">
          <button type="button" data-action="alignLeft" title="Alinhar a esquerda" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="15" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
          </button>
          <button type="button" data-action="alignCenter" title="Centralizar" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="6" x2="18" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
          </button>
          <button type="button" data-action="alignRight" title="Alinhar a direita" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="9" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
          </button>
          <button type="button" data-action="alignJustify" title="Justificar" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
          </button>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Blocos e listas -->
        <div class="toolbar-group">
          <button type="button" data-action="bulletList" title="Lista" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
          </button>
          <button type="button" data-action="orderedList" title="Lista numerada" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="21" y1="6" y2="6"/><line x1="10" x2="21" y1="12" y2="12"/><line x1="10" x2="21" y1="18" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
          </button>
          <button type="button" data-action="blockquote" title="Citacao" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3z"/></svg>
          </button>
          <button type="button" data-action="codeBlock" title="Bloco de codigo" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </button>
          <button type="button" data-action="horizontalRule" title="Linha horizontal" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" x2="21" y1="12" y2="12"/></svg>
          </button>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Insercao -->
        <div class="toolbar-group">
          <button type="button" data-action="link" title="Link (Ctrl+K)" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </button>
          <button type="button" data-action="image" title="Imagem" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </button>
          <button type="button" data-action="youtube" title="Video do YouTube" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>
          </button>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Historico -->
        <div class="toolbar-group">
          <button type="button" data-action="undo" title="Desfazer (Ctrl+Z)" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
          </button>
          <button type="button" data-action="redo" title="Refazer" class="toolbar-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3L21 13"/></svg>
          </button>
        </div>
        <div class="toolbar-divider"></div>

        <!-- Preview -->
        <div class="toolbar-group">
          <button type="button" id="preview-toggle" title="Visualizar como no blog" class="toolbar-btn toolbar-btn-preview">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="ml-1 text-xs">Preview</span>
          </button>
        </div>
      </div>

      <!-- Editor area -->
      <div id="editor-content" class="editor-content"></div>

      <!-- Image toolbar (appears when image is selected) -->
      <div id="image-toolbar" class="image-toolbar hidden">
        <span class="image-toolbar-label">Tamanho:</span>
        <button type="button" data-img-width="160" class="image-toolbar-btn">Pequeno</button>
        <button type="button" data-img-width="320" class="image-toolbar-btn">Medio</button>
        <button type="button" data-img-width="480" class="image-toolbar-btn">Grande</button>
        <button type="button" data-img-width="" class="image-toolbar-btn">Original</button>
      </div>

      <!-- Status bar -->
      <div id="editor-status" class="editor-status">
        <span id="word-count">0 palavras</span>
        <span class="status-separator">&middot;</span>
        <span id="char-count">0 caracteres</span>
      </div>
    </div>
    <script is:inline define:vars={{ initialContent: post?.content || '' }}>
      window.__editorInitialContent = initialContent
    </script>

    <!-- Preview panel (simula a pagina do blog) -->
    <div id="preview-panel" class="preview-panel hidden">
      <div class="preview-panel-header">
        <span class="text-sm font-medium text-white">Pre-visualizacao do artigo</span>
        <button type="button" id="preview-close" class="preview-close-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="preview-panel-body">
        <article class="pt-8 pb-16">
          <div class="prose">
            <header class="mb-8">
              <h1 id="preview-title" class="text-grafite mb-4 text-3xl font-bold sm:text-4xl"></h1>
              <div class="text-grafite/60 flex flex-wrap items-center gap-4 text-sm">
                <time id="preview-date"></time>
                <span id="preview-author"></span>
              </div>
            </header>
            <div id="preview-content"></div>
          </div>
        </article>
      </div>
    </div>
  </div>

  <!-- Autor -->
  <div>
    <label for="authorName" class="mb-1 block text-sm font-medium">
      Autor <span class="text-grafite/50 font-normal">(opcional)</span>
    </label>
    <input type="text" id="authorName" name="authorName" value={post ? '' : 'Projeto Padres para a Igreja de Palmas'}
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-azul focus:ring-azul focus:outline-none focus:ring-1"
      placeholder="Nome do autor" />
    <script is:inline define:vars={{ postAuthor: post?.authorName || '' }}>
      if (postAuthor) document.getElementById('authorName').value = postAuthor
    </script>
  </div>

  <!-- Imagem de capa -->
  <div>
    <label for="heroImage" class="mb-1 block text-sm font-medium">
      Imagem de capa <span class="text-grafite/50 font-normal">(opcional)</span>
    </label>
    <input type="url" id="heroImage" name="heroImage" value={post?.heroImage || ''}
      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-azul focus:ring-azul focus:outline-none focus:ring-1"
      placeholder="https://exemplo.com/imagem.jpg" />
    <div class="image-upload-controls">
      <label for="hero-image-file" class="image-upload-button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" x2="12" y1="3" y2="15"/>
        </svg>
        Enviar imagem
      </label>
      <input
        type="file"
        id="hero-image-file"
        class="sr-only"
        accept="image/jpeg,image/png,image/webp,image/avif"
      />
      <span id="hero-upload-status" class="image-upload-help" aria-live="polite">
        JPG, PNG, WebP ou AVIF, até 5 MB
      </span>
    </div>
    <div id="hero-image-preview" class:list={['hero-image-preview', { hidden: !post?.heroImage }]}>
      <img
        id="hero-image-preview-img"
        src={post?.heroImage || ''}
        alt="Prévia da imagem de capa"
      />
    </div>
  </div>

  <div class="flex items-center gap-2">
    <input type="checkbox" id="published" name="published" class="h-4 w-4 rounded" checked={post?.published || false} />
    <label for="published" class="text-sm font-medium">
      {isEditing ? 'Publicado' : 'Publicar imediatamente'}
    </label>
  </div>

  <div class="flex items-center gap-4 border-t border-gray-200 pt-6">
    <button
      type="submit"
      id="post-submit"
      class="bg-verde hover:bg-verde/90 rounded-lg px-6 py-2.5 font-medium text-white transition-colors disabled:cursor-not-allowed disabled:opacity-60"
    >
      {isEditing ? 'Salvar alteracoes' : 'Salvar publicacao'}
    </button>
    <span id="form-status" class="text-sm"></span>
    <span id="autosave-status" class="text-grafite/40 ml-auto text-xs"></span>
  </div>
</form>

<!-- Dialogs (fora do form principal) -->
<dialog id="dialog-link" class="editor-dialog">
  <div class="dialog-header">
    <h3 class="font-display text-base font-bold">Inserir link</h3>
    <button type="button" class="dialog-close" aria-label="Fechar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <form method="dialog" class="dialog-body">
    <div>
      <label for="dialog-link-url" class="mb-1 block text-sm font-medium">URL</label>
      <input type="url" id="dialog-link-url" required placeholder="https://exemplo.com" class="dialog-input" />
    </div>
    <div class="dialog-footer">
      <button type="button" class="dialog-cancel">Cancelar</button>
      <button type="submit" class="dialog-submit">Inserir</button>
    </div>
  </form>
</dialog>

<dialog id="dialog-image" class="editor-dialog">
  <div class="dialog-header">
    <h3 class="font-display text-base font-bold">Inserir imagem</h3>
    <button type="button" class="dialog-close" aria-label="Fechar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <form id="image-dialog-form" class="dialog-body">
    <div>
      <label for="dialog-image-file" class="mb-1 block text-sm font-medium">
        Enviar do computador
      </label>
      <input
        type="file"
        id="dialog-image-file"
        class="dialog-file-input"
        accept="image/jpeg,image/png,image/webp,image/avif"
      />
      <p class="image-upload-help">JPG, PNG, WebP ou AVIF, até 5 MB</p>
      <progress id="dialog-image-progress" class="image-upload-progress" max="100" value="0" hidden>
        0%
      </progress>
    </div>
    <div class="dialog-separator"><span>ou use uma URL</span></div>
    <div>
      <label for="dialog-image-url" class="mb-1 block text-sm font-medium">URL da imagem</label>
      <input type="url" id="dialog-image-url" placeholder="https://exemplo.com/imagem.jpg" class="dialog-input" />
    </div>
    <div>
      <label for="dialog-image-alt" class="mb-1 block text-sm font-medium">
        Descricao <span class="text-grafite/50 font-normal">(opcional)</span>
      </label>
      <input type="text" id="dialog-image-alt" placeholder="Descricao da imagem" class="dialog-input" />
    </div>
    <p id="dialog-image-status" class="image-upload-status" aria-live="polite"></p>
    <div class="dialog-footer">
      <button type="button" class="dialog-cancel">Cancelar</button>
      <button type="submit" id="dialog-image-submit" class="dialog-submit">Inserir imagem</button>
    </div>
  </form>
</dialog>

<dialog id="dialog-youtube" class="editor-dialog">
  <div class="dialog-header">
    <h3 class="font-display text-base font-bold">Inserir video do YouTube</h3>
    <button type="button" class="dialog-close" aria-label="Fechar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <form method="dialog" class="dialog-body">
    <div>
      <label for="dialog-youtube-url" class="mb-1 block text-sm font-medium">URL do video</label>
      <input type="url" id="dialog-youtube-url" required placeholder="https://www.youtube.com/watch?v=..." class="dialog-input" />
    </div>
    <div class="dialog-footer">
