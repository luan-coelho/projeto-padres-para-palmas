---
export const prerender = false

import AdminLayout from '@/layouts/AdminLayout.astro'
import { db } from '@/db'
import { posts } from '@/db/schema'
import { desc } from 'drizzle-orm'

const allPosts = await db.select().from(posts).orderBy(desc(posts.createdAt))
---

<AdminLayout title="Publicações">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="font-display text-2xl font-bold">Publicações</h1>
    <a
      href="/admin/novo"
      class="bg-verde hover:bg-verde/90 rounded-lg px-4 py-2 text-sm font-medium text-white transition-colors"
    >
      Nova publicação
    </a>
  </div>

  {
    allPosts.length === 0 ? (
      <div class="rounded-2xl bg-gray-50 py-16 text-center">
        <p class="text-grafite/60 text-lg">Nenhuma publicação ainda.</p>
        <a href="/admin/novo" class="text-verde mt-2 inline-block text-sm hover:underline">
          Criar a primeira publicação
        </a>
      </div>
    ) : (
      <div class="space-y-4">
        {allPosts.map(post => (
          <div class="flex items-center justify-between rounded-xl border border-gray-200 bg-white p-5">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-3">
                <h2 class="text-grafite truncate text-lg font-semibold">{post.title}</h2>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium',
                    post.published
                      ? 'bg-green-100 text-green-700'
                      : 'bg-yellow-100 text-yellow-700',
                  ]}
                >
                  {post.published ? 'Publicado' : 'Rascunho'}
                </span>
              </div>
              <p class="text-grafite/50 mt-1 text-sm">
                {new Date(post.createdAt).toLocaleDateString('pt-BR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
                {' — '}
                {post.authorName}
              </p>
            </div>

            <div class="ml-4 flex shrink-0 items-center gap-2">
              <a
                href={`/admin/editar/${post.id}`}
                class="rounded-lg bg-gray-100 px-3 py-1.5 text-sm text-gray-700 transition-colors hover:bg-gray-200"
              >
                Editar
              </a>
              <button
                data-delete-id={post.id}
                data-delete-title={post.title}
                class="delete-btn rounded-lg bg-red-50 px-3 py-1.5 text-sm text-red-600 transition-colors hover:bg-red-100"
              >
                Excluir
              </button>
            </div>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>

<script>
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.deleteId
      const title = (btn as HTMLElement).dataset.deleteTitle

      if (!confirm(`Tem certeza que deseja excluir "${title}"?`)) return

      const res = await fetch(`/api/posts/${id}`, { method: 'DELETE' })
      if (res.ok) {
        window.location.reload()
      } else {
        alert('Erro ao excluir a publicação.')
      }
    })
  })
</script>
