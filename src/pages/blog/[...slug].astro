---
import type { GetStaticPaths } from 'astro'
import { db } from '@/db'
import { posts } from '@/db/schema'
import { eq } from 'drizzle-orm'
import BlogPost from '@/layouts/BlogPost.astro'
import { resolvePostSocialImage } from '@/lib/post-images'

export const getStaticPaths = (async () => {
  const publishedPosts = await db.select().from(posts).where(eq(posts.published, true))

  return publishedPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const socialImage = resolvePostSocialImage(post)
---

<BlogPost
  title={post.title}
  description={post.description}
  pubDate={new Date(post.createdAt)}
  updatedDate={new Date(post.updatedAt)}
  author={post.authorName}
  heroImage={post.heroImage ?? undefined}
  socialImage={socialImage}
  attachments={post.attachments}
>
  <Fragment set:html={post.content} />
</BlogPost>
