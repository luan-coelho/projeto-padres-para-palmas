---
export const prerender = true

import MainLayout from '@/layouts/MainLayout.astro'
import { Image } from 'astro:assets'
import logoColorida from '@/assets/images/logo-colorida.png'
import { SITE_TITLE } from '@/consts'
---

<MainLayout title={`Pagina nao encontrada | ${SITE_TITLE}`} description="A pagina que voce procura nao foi encontrada.">
  <section class="bg-bg-azul flex min-h-screen flex-col items-center justify-center px-4 pt-20 pb-20">
    <Image
      src={logoColorida}
      alt={SITE_TITLE}
      class="mb-8 h-24 w-auto opacity-40"
      width={96}
    />

    <h1 class="font-display text-grafite mb-2 text-center text-6xl font-bold sm:text-8xl">
      404
    </h1>

    <p class="text-grafite/70 mb-8 text-center text-lg sm:text-xl">
      A pagina que voce procura nao foi encontrada.
    </p>

    <a
      href="/"
      class="bg-verde hover:bg-verde/90 inline-flex items-center gap-2 rounded-full px-8 py-3 font-medium text-white transition-colors"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Voltar ao inicio
    </a>
  </section>
</MainLayout>
