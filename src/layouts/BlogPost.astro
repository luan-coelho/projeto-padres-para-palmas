---
import MainLayout from './MainLayout.astro'
import { SITE_URL, SITE_TITLE } from '@/consts'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  author: string
  heroImage?: string
  socialImage?: string
}

const { title, description, pubDate, updatedDate, author, heroImage, socialImage } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString()
const ogImage = socialImage ? new URL(socialImage, SITE_URL).toString() : undefined

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(ogImage && { image: ogImage }),
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  inLanguage: 'pt-BR',
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
}
---

<MainLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  ogImageAlt={`Imagem de compartilhamento do artigo: ${title}`}
  ogType="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article class="pt-28 pb-16">
    {
      heroImage && (
        <img
          src={heroImage}
          alt=""
          class="mx-auto mb-8 max-h-96 w-full max-w-4xl rounded-xl object-contain"
        />
      )
    }
    <div class="prose">
      <header class="mb-8">
        <h1 class="text-grafite mb-4 text-3xl font-bold sm:text-4xl">{title}</h1>
        <div class="text-grafite/60 flex flex-wrap items-center gap-4 text-sm">
          <time datetime={pubDate.toISOString()}>
            {
              pubDate.toLocaleDateString('pt-BR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
          {author && <span>por {author}</span>}
          {
            updatedDate && (
              <span class="italic">
                (atualizado em{' '}
                <time datetime={updatedDate.toISOString()}>
                  {updatedDate.toLocaleDateString('pt-BR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                )
              </span>
            )
          }
        </div>
      </header>
      <slot />
    </div>
  </article>
</MainLayout>
