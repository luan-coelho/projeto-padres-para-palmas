---
import MainLayout from './MainLayout.astro'
import { SITE_URL, SITE_TITLE } from '@/consts'
import {
  formatAttachmentSize,
  getAttachmentTypeLabel,
  type PostAttachment,
} from '@/lib/post-attachments'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  author: string
  heroImage?: string
  socialImage?: string
  attachments?: PostAttachment[]
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  heroImage,
  socialImage,
  attachments = [],
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString()
const ogImage = socialImage ? new URL(socialImage, SITE_URL).toString() : undefined

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(ogImage && { image: ogImage }),
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: {
    '@type': 'Organization',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: SITE_URL,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  inLanguage: 'pt-BR',
}

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
}
---

<MainLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  ogImageAlt={`Imagem de compartilhamento do artigo: ${title}`}
  ogType="article"
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article class="pt-28 pb-16">
    {
      heroImage && (
        <div class="mx-auto mb-8 w-full max-w-4xl overflow-hidden rounded-xl bg-grafite/5">
          <img src={heroImage} alt="" class="max-h-96 w-full object-contain" />
        </div>
      )
    }
    <div class="prose">
      <header class="mb-8">
        <h1 class="text-grafite mb-4 text-3xl font-bold sm:text-4xl">{title}</h1>
        <div class="text-grafite/60 flex flex-wrap items-center gap-4 text-sm">
          <time datetime={pubDate.toISOString()}>
            {
              pubDate.toLocaleDateString('pt-BR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
          {author && <span>por {author}</span>}
          {
            updatedDate && (
              <span class="italic">
                (atualizado em{' '}
                <time datetime={updatedDate.toISOString()}>
                  {updatedDate.toLocaleDateString('pt-BR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                )
              </span>
            )
          }
        </div>
      </header>
      <slot />
    </div>
    {
      attachments.length > 0 && (
        <section
          class="mx-auto mt-10 w-[720px] max-w-[calc(100%-2em)] border-t border-gray-200 px-4 pt-8"
          aria-labelledby="materiais-complementares"
        >
          <h2 id="materiais-complementares" class="font-display text-grafite text-xl font-bold">
            Materiais complementares
          </h2>
          <p class="text-grafite/60 mt-2 text-sm">
            Documentos e arquivos relacionados a esta publicação.
          </p>
          <ul class="mt-5 space-y-3">
            {attachments.map(attachment => (
              <li class="flex flex-col gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center">
                {attachment.contentType.startsWith('image/') ? (
                  <img
                    src={attachment.url}
                    alt=""
                    loading="lazy"
                    class="h-16 w-16 shrink-0 rounded-lg bg-gray-50 object-cover"
                  />
                ) : (
                  <div
                    class:list={[
                      'flex h-16 w-16 shrink-0 items-center justify-center rounded-lg',
                      attachment.contentType === 'application/pdf'
                        ? 'bg-red-50 text-red-600'
                        : 'bg-blue-50 text-blue-600',
                    ]}
                    aria-hidden="true"
                  >
                    <svg
                      width="28"
                      height="28"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <path d="M14 2v6h6" />
                      <path d="M8 13h8" />
                      <path d="M8 17h6" />
                    </svg>
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <p class="text-grafite truncate font-semibold">{attachment.name}</p>
                  <p class="text-grafite/55 mt-1 text-xs">
                    {getAttachmentTypeLabel(attachment.contentType)} ·{' '}
                    {formatAttachmentSize(attachment.size)}
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <a
                    href={attachment.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-azul hover:bg-azul/5 inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium transition-colors"
                  >
                    Abrir
                  </a>
                  <a
                    href={attachment.downloadUrl}
                    download
                    class="bg-verde hover:bg-verde/90 inline-flex items-center rounded-lg px-3 py-2 text-sm font-medium text-white transition-colors"
                  >
                    Baixar
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</MainLayout>
