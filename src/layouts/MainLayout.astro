---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  canonicalURL?: string
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  jsonLd?: object[]
}

const props = Astro.props
---

<BaseLayout {...props}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
